-- // REQUEST
local function req(url)
    task.wait(CFG.REQ_DELAY)
    local ok, res = pcall(request, {
        Url = url, Method = "GET",
        Headers = { ["Accept"] = "application/json" }
    })
    if not ok or not res then return nil end
    local s = res.StatusCode or res.Status or 0
    if s == 429 then warn("[H] 429 rate limit — wait 5s") task.wait(5) return nil end
    if s == 200 then return res.Body end
    return nil
end

-- // BUSCA IDS
local function buscarIds()
    local sort = SORTS[sortIdx]
    sortIdx = (sortIdx % #SORTS) + 1
    local body = req(string.format(
        "https://apis.roproxy.com/explore-api/v1/get-sort-content?sortId=%s&sessionId=x&startIndex=0&pageType=home&country=BR",
        sort
    ))
    if not body then return {} end
    local ok, d = pcall(HTS.JSONDecode, HTS, body)
    if not ok or not d then return {} end
    local ids = {}
    for _, g in ipairs(d.games or {}) do
        local uid = tonumber(g.universeId)
        if uid then table.insert(ids, uid) end
    end
    print(string.format("[H] Sort '%s' → %d IDs", sort, #ids))
    return ids
end

-- // BUSCA DETALHES EM LOTES
local function buscarDetalhes(ids)
    local todos, lote = {}, {}
    for i, uid in ipairs(ids) do
        table.insert(lote, uid)
        if #lote == 10 or i == #ids then
            local body = req("https://games.roproxy.com/v1/games?universeIds=" .. table.concat(lote,"&universeIds="))
            if body then
                local ok, d = pcall(HTS.JSONDecode, HTS, body)
                if ok and d then
                    for _, j in ipairs(d.data or {}) do
                        table.insert(todos, j)
                    end
                end
            end
            lote = {}
        end
    end
    return todos
end

-- // FILTRA E MONTA FILA
local function buscarJogos()
    print("[H] Buscando jogos...")
    local ids = buscarIds()
    if #ids == 0 then return end
    local detalhes = buscarDetalhes(ids)
    print(string.format("[H] %d jogos retornados", #detalhes))

    for _, j in ipairs(detalhes) do
        local pid  = tonumber(j.rootPlaceId)
        local uid  = tonumber(j.id)
        local play = tonumber(j.playing or 0)
        local nome = tostring(j.name or "?")
        local ver  = j.creator and j.creator.hasVerifiedBadge == true

        if not pid or pid == 0 then continue end
        if play < CFG.MIN_PLAYERS or play >= CFG.MAX_PLAYERS then continue end
        if ver then continue end
        if CFG.SKIP_CURRENT and pid == game.PlaceId then continue end

        -- // evita duplicatas
        local existe = false
        for _, f in ipairs(jogosFila) do
            if f.placeId == pid then existe = true break end
        end
        if existe then continue end

        local entrada = {placeId=pid, universeId=uid, nome=nome, jogadores=play}
        table.insert(jogosFila, entrada)
        table.insert(jogosLista, entrada)

        print(string.format("[H] ✓ %s | %d players", nome, play))
    end

    print(string.format("[H] Fila: %d jogos", #jogosFila))
end

