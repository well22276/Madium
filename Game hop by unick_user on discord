-- // HOP
local function hopParaJogo(jogo)
    jogoAtual = jogo.nome
    updUI()
    print(string.format("[H] → %s | %d players", jogo.nome, jogo.jogadores))
    for t = 1, CFG.MAX_TENTATIVAS do
        if not hopAtivo then return false end
        local ok, err = pcall(TS.Teleport, TS, jogo.placeId, LP)
        if ok then
            totalHops = totalHops + 1
            updUI()
            print(string.format("[H] ✓ Hop #%d — fuck yeah boss man!", totalHops))
            return true
        end
        warn(string.format("[H] T%d: %s", t, tostring(err)))
        task.wait(CFG.DELAY_ENTRE_TENTATIVAS or 2)
    end
    return false
end

