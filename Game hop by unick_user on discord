-- // LOOP PRINCIPAL
local function iniciarLoop()
    task.spawn(function()
        print("[H] Iniciado — fuck yeah boss man.")

        if #jogosFila == 0 then
            buscarJogos()
            atualizarListaUI()
        end

        while hopAtivo and _G.HOPPER_ATIVO do
            updUI()

            if #jogosFila == 0 then
                print("[H] Fila vazia — reabastecendo...")
                buscarJogos()
                atualizarListaUI()
                task.wait(2)
                continue
            end

            local jogo = table.remove(jogosFila, 1)
            hopTimer = 0
            local ok = hopParaJogo(jogo)

            if ok then
                -- // countdown
                local elapsed = 0
                while elapsed < CFG.HOP_DELAY and hopAtivo and not skipFlag do
                    task.wait(0.1)
                    elapsed = elapsed + 0.1
                    hopTimer = elapsed
                    updUI()
                end
                skipFlag = false
            else
                task.wait(0.5)
            end
        end

        hopAtivo = false
        updUI()
        print("[H] Loop encerrado.")
    end)
end

